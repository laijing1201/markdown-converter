{
  "name": "markdown-converter",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "dev:electron": "vite",
    "build": "tsc && vite build",
    "build:web": "tsc && vite build",
    "build:electron": "tsc && vite build && electron-builder",
    "build:exe": "npm run build:electron",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-omml.mjs && tsx scripts/test-markdown.ts && tsx scripts/test-chat-import.ts && tsx scripts/test-batch-export.ts && tsx scripts/test-ai-word-fix.ts && tsx scripts/test-account.ts && tsx scripts/test-docx-xml.ts && tsx scripts/test-pdf-unit.ts && tsx scripts/test-pdf-writer.ts && tsx scripts/test-adapters.ts && tsx scripts/test-adapter-contract.ts && tsx scripts/test-ext-ui.ts && tsx scripts/test-ext-pipeline.ts",
    "test:web:e2e": "node scripts/test-web-e2e.mjs",
    "icons:ext": "node scripts/generate-ext-icons.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "test:adapter": "tsx scripts/test-adapters.ts",
    "test:ext:pipeline": "tsx scripts/test-ext-pipeline.ts",
    "test:ext:e2e": "node scripts/test-ext-e2e.mjs",
    "test:pdf:e2e": "node scripts/test-pdf-e2e.mjs",
    "test:pdf:verify": "node scripts/test-pdf-verify.mjs",
    "test:pdf:visual": "node scripts/test-pdf-visual.mjs",
    "test:pdf:stress": "node scripts/test-pdf-stress.mjs",
    "test:adapter:contract": "tsx scripts/test-adapter-contract.ts",
    "test:ext:ui": "tsx scripts/test-ext-ui.ts",
    "audit:extension": "node scripts/audit-extension.mjs",
    "package:extension": "node scripts/package-extension.mjs"
  },
  "build": {
    "appId": "com.markdoc.app",
    "productName": "MarkDoc",
    "icon": "public/icon-v3.png",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "dependencies": {
    "@codemirror/commands": "^6.3.3",
    "@codemirror/lang-markdown": "^6.2.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/theme-one-dark": "^6.1.0",
    "@codemirror/view": "^6.23.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/supabase-js": "^2.117.2",
    "@uiw/react-codemirror": "^4.21.21",
    "docx": "^8.5.0",
    "dompurify": "^3.0.6",
    "file-saver": "^2.0.5",
    "harfbuzzjs": "^0.4.9",
    "highlight.js": "^11.9.0",
    "html2canvas": "^1.4.1",
    "jszip": "^3.10.1",
    "katex": "^0.16.9",
    "marked": "^12.0.0",
    "marked-highlight": "^2.1.0",
    "mathml2omml": "^0.5.0",
    "mermaid": "^10.6.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.10",
    "@types/chrome": "^0.3.0",
    "@types/dompurify": "^3.0.5",
    "@types/file-saver": "^2.0.7",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.32",
    "puppeteer-core": "^25.11.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.23.13",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0"
  }
}
